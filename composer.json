{
    "name": "beziworld/laravel-cpanel",
    "description": "Laravel client for cPanel UAPI and WHM API 1: accounts, packages, domains, DNS, e-mail, MySQL, SSL, FTP, cron, files, backups and SSO, for many servers.",
    "keywords": ["laravel","cpanel","whm","uapi","hosting","control-panel","api-client"],
    "homepage": "https://github.com/beziworld/laravel-cpanel",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Kamil Ćwiertnia",
            "email": "biuro@beziworld.eu",
            "homepage": "https://beziworld.eu",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/beziworld/laravel-cpanel/issues",
        "source": "https://github.com/beziworld/laravel-cpanel"
    },
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.8",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.7|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "phpstan/phpstan-strict-rules": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Beziworld\\Cpanel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Beziworld\\Cpanel\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "test-coverage": "pest --coverage --min=80",
        "analyse": "phpstan analyse --memory-limit=1G",
        "format": "pint",
        "lint": "pint --test",
        "ci": [
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Beziworld\\Cpanel\\CpanelServiceProvider"
            ],
            "aliases": {
                "Cpanel": "Beziworld\\Cpanel\\Facades\\Cpanel"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
